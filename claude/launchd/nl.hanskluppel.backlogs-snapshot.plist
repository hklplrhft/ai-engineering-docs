<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hourly snapshot of ~/Development/_backlogs (script: claude/scripts/backlogs-snapshot.sh). Install with
     claude/scripts/install-backlogs-snapshot.sh; it replaces HOME_DIR with the real home directory. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>nl.hanskluppel.backlogs-snapshot</string>
  <key>ProgramArguments</key>
  <array>
    <string>HOME_DIR/scripts/achtergrondtaken/Backlogs-snapshot</string>
  </array>
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>HOME_DIR/Library/Logs/backlogs-snapshot.log</string>
  <key>StandardErrorPath</key>
  <string>HOME_DIR/Library/Logs/backlogs-snapshot.log</string>
</dict>
</plist>
